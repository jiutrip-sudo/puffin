{
  "name": "puffin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate-hero": "node scripts/generate-hero.mjs",
    "generate-og": "node scripts/generate-og-default.mjs",
    "sync-pricing": "SYNC_PRICING_CLI=1 npx tsx scripts/sync-trip-pricing.ts",
    "suggest-fx": "node scripts/suggest-fx-rate.mjs",
    "audit:places": "node scripts/audit-place-names.mjs --fail",
    "audit:images": "node scripts/audit-images.mjs",
    "audit:tw": "node scripts/audit-tw-terms.mjs",
    "media:inventory": "node scripts/build-media-inventory.mjs && node scripts/build-trip-media-inventory.mjs && node scripts/build-pricing-media-inventory.mjs && node scripts/build-guides-media-inventory.mjs",
    "media:inventory:trips": "node scripts/build-trip-media-inventory.mjs",
    "media:inventory:pricing": "node scripts/build-pricing-media-inventory.mjs",
    "media:inventory:guides": "node scripts/build-guides-media-inventory.mjs",
    "media:sync": "node scripts/media-sync.mjs",
    "media:sync:trips": "node scripts/media-sync.mjs --kind trips",
    "media:sync:pricing": "node scripts/media-sync.mjs --kind pricing",
    "media:sync:guides": "node scripts/media-sync.mjs --kind guides",
    "normalize:modal-tw": "npx tsx scripts/normalize-trip-spot-modals.ts --phase=all",
    "db:migrate-bookings": "node scripts/migrate-bookings-to-neon.mjs",
    "db:migrate-dynamic-promos": "node scripts/migrate-dynamic-promos-to-neon.mjs",
    "db:ensure-auth": "node scripts/ensure-auth-tables.mjs"
  },
  "dependencies": {
    "@auth/neon-adapter": "^1.11.3",
    "@neon/config": "^1.1.0",
    "@neon/env": "^1.1.6",
    "@neondatabase/serverless": "^1.1.0",
    "canvas-confetti": "^1.9.4",
    "mapbox-gl": "^3.29.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "opencc-js": "^1.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
